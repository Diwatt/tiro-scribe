{
  "compilerOptions": {
    "target": "ES2020",
    "lib": [
      "ES2020",
      "ESNext.Decorators"
    ],
    "jsx": "react-native",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "allowSyntheticDefaultImports": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,
    "isolatedModules": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "@Service/*": ["src/Service/*"]
    }
  },
  "include": ["src/**/*", "app/**/*", "tests/**/*", "index.js", "vitest.config.ts", "vitest.setup.ts"],
  "exclude": ["node_modules", "modules/**"],
  "extends": "expo/tsconfig.base"
}
