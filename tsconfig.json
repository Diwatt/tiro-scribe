{
    "compilerOptions": {
        "target": "ES2020",
        "lib": ["ES2022", "ESNext.Decorators", "DOM", "ES2015", "ES2016", "ES2017", "ES2018", "ES2019", "ES2020", "ES2021"],
        "jsx": "react-native",
        "strict": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "resolveJsonModule": true,
        "allowSyntheticDefaultImports": true,
        "forceConsistentCasingInFileNames": true,
        "noEmit": true,
        "isolatedModules": true,
        "baseUrl": ".",
        "paths": {
            "@/*": ["src/*"],
            "@Service/*": ["src/Service/*"]
        }
    },
    "include": ["src/**/*", "app/**/*", "tests/**/*", "index.js", "vitest.config.ts", "vitest.setup.ts"],
    "exclude": ["node_modules", "modules/**"],
    "extends": "expo/tsconfig.base"
}
