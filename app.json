{
    "expo": {
        "name": "Tiro Scribe",
        "scheme": "tiro-scribe",
        "slug": "tiro-scribe",
        "version": "0.1.0",
        "newArchEnabled": true,
        "icon": "./assets/icon.png",
        "orientation": "portrait",
        "assetBundlePatterns": ["**/*"],
        "ios": {
            "supportsTablet": true,
            "bundleIdentifier": "com.tiroscribe.app",
            "infoPlist": {
                "NSMicrophoneUsageDescription": "Tiro Scribe needs access to your microphone to record clinical sessions for research purposes.",
                "NSPhotoLibraryUsageDescription": "Tiro Scribe needs access to your photo library to save processed audio files.",
                "NSDocumentsFolderUsageDescription": "Tiro Scribe needs access to your documents folder to store encrypted research data."
            },
            "jsEngine": "hermes"
        },
        "android": {
            "package": "com.tiroscribe.app",
            "permissions": ["android.permission.RECORD_AUDIO"],
            "jsEngine": "hermes"
        },
        "plugins": [
            [
                "expo-build-properties",
                {
                    "hermesEnabled": true,
                    "android": {
                        "hermesEnabled": true,
                        "packagingOptions": {
                            "pickFirst": ["**/libc++_shared.so", "**/libfbjni.so", "**/libonnxruntime.so"]
                        },
                        "minSdkVersion": 29,
                        "compileSdkVersion": 35,
                        "targetSdkVersion": 35,
                        "buildToolsVersion": "35.0.0",
                        "kotlinVersion": "2.0.21",
                        "jvmArgs": ["-Xmx4096m", "-XX:MaxMetaspaceSize=1024m"]
                    },
                    "ios": {
                        "deploymentTarget": "16.0",
                        "useFrameworks": "static"
                    }
                }
            ],
            [
                "expo-audio",
                {
                    "microphonePermission": "Tiro Scribe needs access to your microphone to record clinical sessions for research purposes."
                }
            ],
            "expo-file-system",
            "expo-asset"
        ],
        "extra": {
            "eas": {
                "projectId": null
            }
        }
    }
}
