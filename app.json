{
  "expo": {
    "name": "Tiro Scribe",
    "scheme": "tiro-scribe",
    "slug": "tiro-scribe",
    "version": "0.1.0",
    "icon": "./assets/icon.png",
    "orientation": "portrait",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.tiroscribe.app",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Tiro Scribe needs access to your microphone to record clinical sessions for research purposes.",
        "NSPhotoLibraryUsageDescription": "Tiro Scribe needs access to your photo library to save processed audio files.",
        "NSDocumentsFolderUsageDescription": "Tiro Scribe needs access to your documents folder to store encrypted research data."
      }
    },
    "android": {
      "package": "com.tiroscribe.app",
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "plugins": [
      [
        "expo-build-properties",
        {
          "buildReactNativeFromSource": true,
          "hermesEnabled": true,
          "android": {
            "hermesEnabled": true,
            "packagingOptions": {
              "pickFirst": [
                "**/libc++_shared.so",
                "**/libfbjni.so",
                "**/libonnxruntime.so"
              ]
            },
            "minSdkVersion": 29,
            "compileSdkVersion": 37,
            "targetSdkVersion": 36,
            "kotlinVersion": "2.0.21",
            "jvmArgs": [
              "-Xmx2048m",
              "-XX:MaxMetaspaceSize=512m"
            ]
          },
          "ios": {
            "deploymentTarget": "16.4",
            "useFrameworks": "static"
          }
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Tiro Scribe needs access to your microphone to record clinical sessions for research purposes."
        }
      ],
      "expo-file-system",
      "expo-asset",
      "./plugins/withGradleLimits",
      "./plugins/withOnnxruntime",
      "onnxruntime-react-native",
      "@react-native-community/datetimepicker",
      "expo-localization",
      "expo-router",
      "expo-secure-store",
      "expo-sqlite",
      "expo-sharing",
      "expo-splash-screen"
    ],
    "extra": {
      "eas": {
        "projectId": null
      },
      "expo-router": {
        "appRoot": "app"
      }
    }
  }
}
