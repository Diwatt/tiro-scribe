require File.join(File.dirname(`node --print "require.resolve('expo/package.json')"`), "scripts/autolinking")
require File.join(File.dirname(`node --print "require.resolve('react-native/package.json')"`), "scripts/react_native_pods")

require 'json'
podfile_properties = JSON.parse(File.read(File.join(__dir__, 'Podfile.properties.json'))) rescue {}

def patch_react_native_screens_missing_return!
  screens_file = Dir.glob(File.join(__dir__, '..', 'node_modules', '.pnpm', 'react-native-screens@*', 'node_modules', 'react-native-screens', 'ios', 'RNSScreenStackHeaderConfig.mm')).first
  return if screens_file.nil?

  content = File.read(screens_file)
  marker = "return RCTResizeModeCover; // fallback for older react-native-screens"
  return if content.include?(marker)

  original = <<~CPP
    static RCTResizeMode resizeModeFromCppEquiv(react::ImageResizeMode resizeMode)
    {
      switch (resizeMode) {
        case react::ImageResizeMode::Cover:
          return RCTResizeModeCover;
        case react::ImageResizeMode::Contain:
          return RCTResizeModeContain;
        case react::ImageResizeMode::Stretch:
          return RCTResizeModeStretch;
        case react::ImageResizeMode::Center:
          return RCTResizeModeCenter;
        case react::ImageResizeMode::Repeat:
          return RCTResizeModeRepeat;
      }
    }
  CPP

  patched = <<~CPP
    static RCTResizeMode resizeModeFromCppEquiv(react::ImageResizeMode resizeMode)
    {
      switch (resizeMode) {
        case react::ImageResizeMode::Cover:
          return RCTResizeModeCover;
        case react::ImageResizeMode::Contain:
          return RCTResizeModeContain;
        case react::ImageResizeMode::Stretch:
          return RCTResizeModeStretch;
        case react::ImageResizeMode::Center:
          return RCTResizeModeCenter;
        case react::ImageResizeMode::Repeat:
          return RCTResizeModeRepeat;
      }

      return RCTResizeModeCover; // fallback for older react-native-screens
    }
  CPP

  if content.include?(original)
    File.write(screens_file, content.sub(original, patched))
    Pod::UI.puts '[TiroScribe] Patched react-native-screens missing return in resizeModeFromCppEquiv'
  end
end

def patch_react_native_screens_shadow_mutation_api!
  listener_file = Dir.glob(File.join(__dir__, '..', 'node_modules', '.pnpm', 'react-native-screens@*', 'node_modules', 'react-native-screens', 'cpp', 'RNSScreenRemovalListener.cpp')).first
  return if listener_file.nil?

  content = File.read(listener_file)
  marker = 'strcmp(mutation.oldChildShadowView.componentName, "RNSScreen") == 0'
  return if content.include?(marker)

  patched_content = content
    .gsub(
      "strcmp(mutation.parentShadowView.componentName, \"RNSScreenStack\") ==\n            0",
      "strcmp(mutation.oldChildShadowView.componentName, \"RNSScreen\") == 0"
    )

  if patched_content != content
    File.write(listener_file, patched_content)
    Pod::UI.puts '[TiroScribe] Patched react-native-screens ShadowViewMutation API usage'
  end
end

def patch_react_native_screens_parent_tag_in_stack!
  stack_file = Dir.glob(File.join(__dir__, '..', 'node_modules', '.pnpm', 'react-native-screens@*', 'node_modules', 'react-native-screens', 'ios', 'RNSScreenStack.mm')).first
  return if stack_file.nil?

  content = File.read(stack_file)
  return if content.include?('mutation.parentTag == self.tag')

  patched_content = content.gsub('mutation.parentShadowView.tag == self.tag', 'mutation.parentTag == self.tag')

  if patched_content != content
    File.write(stack_file, patched_content)
    Pod::UI.puts '[TiroScribe] Patched react-native-screens RNSScreenStack parentTag usage'
  end
end

def patch_expo_modules_core_runtime_executor_include!
  bridgeless_file = Dir.glob(File.join(__dir__, '..', 'node_modules', '.pnpm', 'expo-modules-core@*', 'node_modules', 'expo-modules-core', 'common', 'cpp', 'BridgelessJSCallInvoker.h')).first
  return if bridgeless_file.nil?

  content = File.read(bridgeless_file)
  return if content.include?('<runtimeexecutor/ReactCommon/RuntimeExecutor.h>')

  patched_content = content.gsub(
    '#include <ReactCommon/RuntimeExecutor.h>',
    '#include <runtimeexecutor/ReactCommon/RuntimeExecutor.h>'
  )

  if patched_content != content
    File.write(bridgeless_file, patched_content)
    Pod::UI.puts '[TiroScribe] Patched expo-modules-core RuntimeExecutor include path'
  end
end

def ccache_enabled?(podfile_properties)
  # Environment variable takes precedence
  return ENV['USE_CCACHE'] == '1' if ENV['USE_CCACHE']
  
  # Fall back to Podfile properties
  podfile_properties['apple.ccacheEnabled'] == 'true'
end

ENV['RCT_NEW_ARCH_ENABLED'] ||= '0' if podfile_properties['newArchEnabled'] == 'false'
ENV['EX_DEV_CLIENT_NETWORK_INSPECTOR'] ||= podfile_properties['EX_DEV_CLIENT_NETWORK_INSPECTOR']
ENV['RCT_USE_RN_DEP'] ||= '0' if podfile_properties['ios.buildReactNativeFromSource'] != 'true' && podfile_properties['newArchEnabled'] != 'false'
ENV['RCT_USE_PREBUILT_RNCORE'] ||= '0' if podfile_properties['ios.buildReactNativeFromSource'] != 'true' && podfile_properties['newArchEnabled'] != 'false'
platform :ios, podfile_properties['ios.deploymentTarget'] || '15.1'

prepare_react_native_project!

target 'TiroScribe' do
  use_expo_modules!

  if ENV['EXPO_USE_COMMUNITY_AUTOLINKING'] == '1'
    config_command = ['node', '-e', "process.argv=['', '', 'config'];require('@react-native-community/cli').run()"];
  else
    config_command = [
      'node',
      '--no-warnings',
      '--eval',
      'require(\'expo/bin/autolinking\')',
      'expo-modules-autolinking',
      'react-native-config',
      '--json',
      '--platform',
      'ios'
    ]
  end

  config = use_native_modules!(config_command)

  use_frameworks! :linkage => podfile_properties['ios.useFrameworks'].to_sym if podfile_properties['ios.useFrameworks']
  use_frameworks! :linkage => ENV['USE_FRAMEWORKS'].to_sym if ENV['USE_FRAMEWORKS']

  use_react_native!(
    :path => config[:reactNativePath],
    :hermes_enabled => podfile_properties['expo.jsEngine'] == nil || podfile_properties['expo.jsEngine'] == 'hermes',
    # An absolute path to your application root.
    :app_path => "#{Pod::Config.instance.installation_root}/..",
    :privacy_file_aggregation_enabled => podfile_properties['apple.privacyManifestAggregationEnabled'] != 'false',
  )

  post_install do |installer|
    patch_react_native_screens_missing_return!
    patch_react_native_screens_shadow_mutation_api!
    patch_react_native_screens_parent_tag_in_stack!
    patch_expo_modules_core_runtime_executor_include!

    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false,
      :ccache_enabled => ccache_enabled?(podfile_properties),
    )
  end
end
