{
  "name": "tiro-scribe",
  "version": "0.1.0",
  "private": true,
  "description": "Privacy-first clinical research app with on-device AI processing",
  "onnxruntimeExtensionsEnabled": "true",
  "main": "index.js",
  "workspaces": [
    "modules/*"
  ],
  "scripts": {
    "preios": "rm -rf $TMPDIR/metro-* $TMPDIR/haste-* /tmp/metro-* /tmp/haste-* 2>/dev/null || true",
    "clean:metro": "rm -rf /tmp/metro-* /tmp/haste-* $TMPDIR/metro-* $TMPDIR/haste-* 2>/dev/null || true",
    "clean": "watchman watch-del-all 2>/dev/null || true; pnpm run clean:metro; rm -rf .expo coverage build ios/Pods ios/build ios/DerivedData android/.gradle android/app/build android/app/.cxx android/build; find . -name '*.tsbuildinfo' -delete 2>/dev/null || true",
    "clean:native": "rm -rf android ios",
    "clean:all": "pnpm run clean && pnpm run clean:native && rm -rf node_modules && pnpm install",
    "prebuild": "pnpx expo prebuild",
    "prebuild:clean": "pnpm run clean:native && pnpx expo prebuild",
    "pods:install": "cd ios && pod install",
    "pods:clean": "cd ios && pod deintegrate && pod install",
    "module:build": "cd modules/secure-recorder && pnpx expo-module clean && pnpx expo-module tsc -p tsconfig.json",
    "android:dev": "STORYBOOK_ENABLED=false pnpm run clean:metro && expo run:android",
    "android:fresh": "STORYBOOK_ENABLED=false pnpm run clean:metro && pnpm run prebuild:clean && expo run:android",
    "ios:dev": "STORYBOOK_ENABLED=false pnpm run preios && pnpm run pods:install && expo run:ios",
    "ios:fresh": "STORYBOOK_ENABLED=false pnpm run preios && pnpm run prebuild:clean && expo run:ios",
    "start": "expo start --dev-client",
    "start:reset": "expo start --clear",
    "storybook": "STORYBOOK_ENABLED=true expo start --clear",
    "storybook:ios": "STORYBOOK_ENABLED=true expo start --clear --ios",
    "storybook:android": "STORYBOOK_ENABLED=true expo start --clear --android",
    "android:logcat": "adb logcat -c && adb logcat ReactNativeJS:V ReactNative:V RCTLog:V Expo:V *:S",
    "generate:api": "node scripts/generate-api.js",
    "mock:server": "node scripts/start-mock-server.js",
    "test": "EXPO_OS=ios pnpm jest",
    "test:watch": "EXPO_OS=ios pnpm jest --watch",
    "test:kotlin": "if [ -d 'android' ] && [ -f 'android/gradlew' ]; then cd android && ./gradlew :secure-recorder:testDebugUnitTest; else echo 'Error: Android project not found'; exit 1; fi",
    "test:swift": "if [ -d 'ios' ] && [ -d 'ios/TiroScribe.xcworkspace' ]; then cd ios && xcodebuild test -workspace TiroScribe.xcworkspace -scheme TiroScribe -destination 'platform=iOS Simulator'; else echo 'Error: iOS workspace not found'; exit 1; fi",
    "test:all": "pnpm jest; pnpm run test:kotlin || true; pnpm run test:swift || true",
    "type-check": "tsc --noEmit",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome lint . --diagnostic-level=error",
    "lint:fix": "biome lint --write .",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "lint:eslint": "eslint . --ext .ts,.tsx,.js,.jsx",
    "lint:eslint:fix": "eslint . --ext .ts,.tsx,.js,.jsx --fix",
    "android": "expo run:android",
    "ios": "expo run:ios"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.2",
    "@legendapp/state": "^2.1.15",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-native-community/datetimepicker": "8.4.4",
    "@react-native-community/slider": "5.0.1",
    "@react-navigation/bottom-tabs": "^7.14.0",
    "@react-navigation/native": "^7.1.28",
    "@react-navigation/native-stack": "^7.13.0",
    "@tanstack/react-query": "^5.90.21",
    "check-password-strength": "^3.0.0",
    "colord": "^2.9.3",
    "dayjs": "^1.11.19",
    "expo": "~54.0.33",
    "expo-asset": "~12.0.0",
    "expo-audio": "~1.1.0",
    "expo-build-properties": "~1.0.0",
    "expo-clipboard": "^8.0.0",
    "expo-constants": "~18.0.13",
    "expo-crypto": "^15.0.0",
    "expo-dev-client": "~6.0.0",
    "expo-device": "~8.0.0",
    "expo-file-system": "~19.0.0",
    "expo-linking": "~8.0.11",
    "expo-localization": "^17.0.0",
    "expo-modules-core": "~3.0.29",
    "expo-print": "~15.0.0",
    "expo-router": "^6.0.0",
    "expo-secure-store": "~15.0.0",
    "expo-sharing": "~14.0.0",
    "expo-splash-screen": "^31.0.0",
    "expo-sqlite": "~16.0.0",
    "kysely": "^0.28.14",
    "kysely-expo": "^5.0.0",
    "lodash": "^4.17.23",
    "lucide-react-native": "^0.575.0",
    "mathjs": "^15.1.1",
    "onnxruntime-react-native": "^1.24.3",
    "react": "19.1.0",
    "react-hook-form": "^7.71.2",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.30.0",
    "react-native-get-random-values": "^2.0.0",
    "react-native-logs": "^5.5.0",
    "react-native-paper": "^5.15.0",
    "react-native-quick-crypto": "^1.0.17",
    "react-native-reanimated": "~4.2.2",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.23.0",
    "react-native-svg": "^15.0.0",
    "react-native-toast-message": "^2.3.3",
    "react-native-worklets": "^0.7.4",
    "secure-recorder": "workspace:*",
    "semver": "^7.7.4",
    "slugify": "^1.6.6",
    "typesafe-i18n": "^5.27.1",
    "uuid": "^13.0.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@babel/plugin-proposal-decorators": "^7.29.0",
    "@babel/preset-env": "^7.29.0",
    "@babel/runtime": "^7.28.6",
    "@biomejs/biome": "^2.4.4",
    "@faker-js/faker": "^10.3.0",
    "@hey-api/openapi-ts": "^0.92.4",
    "@openapitools/openapi-generator-cli": "^2.29.0",
    "@react-native-community/cli": "^20.1.1",
    "@react-native/babel-preset": "^0.84.0",
    "@react-native/metro-config": "^0.84.0",
    "@react-native/typescript-config": "^0.84.0",
    "@storybook/addon-ondevice-actions": "^10.2.3",
    "@storybook/addon-ondevice-controls": "^10.2.3",
    "@storybook/addon-ondevice-notes": "^10.2.3",
    "@storybook/react-native": "^10.2.3",
    "@testing-library/jest-native": "^5.4.0",
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "^30.0.0",
    "@types/lodash": "^4.17.23",
    "@types/node": "^25.3.0",
    "@types/react": "^19.2.14",
    "@types/react-test-renderer": "^19.1.0",
    "@types/semver": "^7.7.1",
    "@typescript-eslint/eslint-plugin": "^8.56.1",
    "@typescript-eslint/parser": "^8.56.1",
    "babel-jest": "^30.0.0",
    "babel-plugin-inline-import": "^3.0.0",
    "babel-plugin-module-resolver": "^5.0.2",
    "babel-plugin-transform-inline-environment-variables": "^0.4.4",
    "babel-preset-expo": "~54.0.10",
    "better-sqlite3": "^12.6.2",
    "esbuild": "^0.27.3",
    "eslint": "^10.0.2",
    "eslint-config-biome": "^2.1.3",
    "eslint-plugin-perfectionist": "^5.6.0",
    "jest": "^30.0.0",
    "jest-expo": "^54.0.0",
    "jest-mock-extended": "^3.0.5",
    "js-yaml": "^4.1.1",
    "json-server": "1.0.0-beta.9",
    "msw": "^2.12.10",
    "react-dom": "19.1.0",
    "react-test-renderer": "19.1.0",
    "reflect-metadata": "^0.2.2",
    "storybook": "^10.2.10",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-test-renderer": "19.1.0"
  },
  "patchedDependencies": {
    "onnxruntime-react-native@1.24.3": "patches/onnxruntime-react-native@1.24.3.patch"
  },
  "trustedDependencies": [
    "esbuild",
    "better-sqlite3"
  ],
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=20.0.0"
  }
}