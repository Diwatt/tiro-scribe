{
    "name": "tiro-scribe",
    "version": "0.1.0",
    "private": true,
    "description": "Privacy-first clinical research app with on-device AI processing",
    "main": "index.js",
    "scripts": {
        "preios": "rm -rf $TMPDIR/metro-* $TMPDIR/haste-* /tmp/metro-* /tmp/haste-* 2>/dev/null || true",
        "android": "STORYBOOK_ENABLED=false expo run:android",
        "android:logcat": "adb logcat -c && adb logcat ReactNativeJS:V ReactNative:V RCTLog:V Expo:V *:S",
        "ios": "STORYBOOK_ENABLED=false expo run:ios",
        "ios:xcode": "open ios/TiroScribe.xcworkspace",
        "prebuild": "expo prebuild",
        "prebuild:clean": "expo prebuild --clean",
        "start": "expo start --dev-client",
        "start:reset": "expo start --clear",
        "prestorybook": "rm -rf $TMPDIR/metro-* $TMPDIR/haste-* /tmp/metro-* /tmp/haste-* node_modules/.cache .expo 2>/dev/null || true",
        "storybook": "STORYBOOK_ENABLED=true expo start --clear",
        "storybook:ios": "STORYBOOK_ENABLED=true expo start --clear --ios",
        "storybook:android": "STORYBOOK_ENABLED=true expo start --clear --android",
        "clean": "watchman watch-del-all 2>/dev/null || true; rm -rf /tmp/metro-* /tmp/haste-* $TMPDIR/metro-* $TMPDIR/haste-* 2>/dev/null; rm -rf .expo node_modules coverage build ios/Pods ios/build ios/DerivedData android/.gradle android/app/build android/app/.cxx android/build; find . -name '*.tsbuildinfo' -delete 2>/dev/null; pnpm install; (test -d ios && cd ios && pod install) || true",
        "clean:metro": "rm -rf /tmp/metro-* /tmp/haste-* $TMPDIR/metro-* $TMPDIR/haste-* 2>/dev/null || true",
        "pods:install": "cd ios && pod install",
        "pods:clean": "cd ios && pod deintegrate && pod install",
        "module:build": "cd modules/secure-recorder && pnpm build",
        "test": "vitest run --passWithNoTests",
        "test:watch": "vitest",
        "test:kotlin": "if [ -d 'android' ] && [ -f 'android/gradlew' ]; then cd android && ./gradlew :secure-recorder:testDebugUnitTest; else echo 'Error: Android project not found'; exit 1; fi",
        "test:swift": "if [ -d 'ios' ] && [ -d 'ios/TiroScribe.xcworkspace' ]; then cd ios && xcodebuild test -workspace TiroScribe.xcworkspace -scheme TiroScribe -destination 'platform=iOS Simulator'; else echo 'Error: iOS workspace not found'; exit 1; fi",
        "test:all": "pnpm test; pnpm test:kotlin || true; pnpm test:swift || true",
        "type-check": "tsc --noEmit",
        "format": "biome format --write .",
        "format:check": "biome format .",
        "lint": "biome lint .",
        "lint:fix": "biome lint --write .",
        "check": "biome check .",
        "check:fix": "biome check --write ."
    },
    "dependencies": {
        "@hookform/resolvers": "^5.0.0",
        "@legendapp/state": "^2.1.15",
        "@react-native-async-storage/async-storage": "^2.2.0",
        "@react-navigation/bottom-tabs": "^7.9.1",
        "@react-navigation/native": "^7.1.27",
        "@react-navigation/native-stack": "^7.9.1",
        "check-password-strength": "^2.0.10",
        "colord": "^2.9.3",
        "crypto-js": "^4.2.0",
        "dayjs": "^1.11.19",
        "expo": "~54.0.31",
        "expo-asset": "~12.0.12",
        "expo-audio": "~1.1.1",
        "expo-build-properties": "~1.0.10",
        "expo-clipboard": "^8.0.8",
        "expo-dev-client": "~6.0.20",
        "expo-device": "~8.0.3",
        "expo-file-system": "~19.0.21",
        "expo-print": "~15.0.0",
        "expo-router": "^6.0.23",
        "expo-secure-store": "~14.0.1",
        "expo-sharing": "~14.0.0",
        "lodash": "^4.17.23",
        "lucide-react-native": "^0.562.0",
        "onnxruntime-react-native": "^1.23.2",
        "react": "19.1.0",
        "react-hook-form": "^7.57.0",
        "react-native": "0.81.5",
        "react-native-gesture-handler": "~2.28.0",
        "react-native-get-random-values": "^2.0.0",
        "react-native-logs": "^5.5.0",
        "react-native-mmkv": "^3.2.0",
        "react-native-paper": "^5.14.5",
        "react-native-reanimated": "~4.1.6",
        "react-native-safe-area-context": "~5.6.2",
        "react-native-screens": "~4.16.0",
        "react-native-svg": "^15.15.1",
        "react-native-toast-message": "^2.3.3",
        "secure-recorder": "workspace:*",
        "semver": "^7.7.3",
        "uuid": "^13.0.0",
        "zod": "^3.24.0"
    },
    "devDependencies": {
        "@babel/core": "^7.28.6",
        "@babel/plugin-proposal-decorators": "^7.29.0",
        "@babel/preset-env": "^7.28.6",
        "@babel/runtime": "^7.28.6",
        "@biomejs/biome": "^2.3.14",
        "@react-native-community/cli": "^20.1.0",
        "@react-native/babel-preset": "^0.83.1",
        "@react-native/metro-config": "^0.83.1",
        "@react-native/typescript-config": "^0.83.1",
        "@storybook/addon-ondevice-actions": "^10.1.11",
        "@storybook/addon-ondevice-controls": "^10.1.11",
        "@storybook/addon-ondevice-notes": "^10.1.11",
        "@storybook/react-native": "^10.1.11",
        "@testing-library/react-native": "^13.3.3",
        "@types/crypto-js": "^4.2.2",
        "@types/lodash": "^4.17.23",
        "@types/react": "^19.1.17",
        "@types/react-test-renderer": "^19.1.0",
        "@types/semver": "^7.7.1",
        "babel-plugin-inline-import": "^3.0.0",
        "babel-plugin-module-resolver": "^5.0.2",
        "babel-plugin-transform-inline-environment-variables": "^0.4.4",
        "esbuild": "^0.27.2",
        "react-dom": "^19.2.3",
        "react-test-renderer": "19.1.0",
        "storybook": "^10.1.11",
        "typescript": "^5.9.3",
        "vitest": "^2.1.0"
    },
    "pnpm": {
        "patchedDependencies": {},
        "onlyBuiltDependencies": [
            "esbuild"
        ]
    },
    "packageManager": "pnpm@10.28.1",
    "engines": {
        "node": ">=18.0.0",
        "pnpm": ">=9.0.0"
    }
}
