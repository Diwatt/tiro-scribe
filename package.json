{
  "name": "tiro-scribe",
  "version": "0.1.0",
  "private": true,
  "description": "Privacy-first clinical research app with on-device AI processing",
  "main": "index.js",
  "scripts": {
    "android": "react-native run-android",
    "ios": "bash scripts/run-ios.sh",
    "pod-install": "cd ios && pod install && cd ..",
    "postinstall": "node scripts/check-pods.js || true",
    "clean": "pnpm run clean:ios && pnpm run clean:android && pnpm run clean:metro",
    "clean:ios": "cd ios && rm -rf build Pods Podfile.lock && cd ..",
    "clean:android": "cd android && ./gradlew clean && cd ..",
    "clean:metro": "rm -rf /tmp/metro-* /tmp/haste-* $TMPDIR/metro-* $TMPDIR/haste-* 2>/dev/null || true",
    "lint": "eslint .",
    "start": "react-native start",
    "start:reset": "react-native start --reset-cache",
    "test": "jest",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@nozbe/simdjson": "^3.9.4",
    "@nozbe/watermelondb": "^0.27.1",
    "@nozbe/with-observables": "^1.5.0",
    "@react-native-async-storage/async-storage": "^2.1.0",
    "@react-navigation/bottom-tabs": "^6.6.1",
    "@react-navigation/native": "^6.1.18",
    "@react-navigation/native-stack": "^6.11.0",
    "crypto-js": "^4.2.0",
    "dayjs": "^1.11.13",
    "onnxruntime-react-native": "^1.23.0",
    "react": "18.3.1",
    "react-native": "0.76.5",
    "react-native-gesture-handler": "^2.20.2",
    "react-native-paper": "^5.12.5",
    "react-native-reanimated": "~3.18.0",
    "react-native-safe-area-context": "^4.12.0",
    "react-native-screens": "4.18.0",
    "uuid": "^11.0.3",
    "whisper.rn": "^0.5.4",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@babel/core": "^7.26.0",
    "@babel/preset-env": "^7.26.0",
    "@babel/runtime": "^7.26.0",
    "@react-native/babel-preset": "^0.76.5",
    "@react-native-community/cli": "^15.0.0",
    "@react-native/eslint-config": "^0.76.5",
    "@react-native/metro-config": "^0.76.5",
    "@react-native/typescript-config": "^0.76.5",
    "@types/crypto-js": "^4.2.2",
    "@types/react": "^18.3.12",
    "@types/react-test-renderer": "^18.3.0",
    "@types/uuid": "^10.0.0",
    "babel-jest": "^29.7.0",
    "babel-plugin-module-resolver": "^5.0.2",
    "eslint": "^8.57.1",
    "jest": "^29.7.0",
    "prettier": "^3.4.2",
    "react-test-renderer": "18.3.1",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=8.0.0"
  }
}
