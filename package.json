{
  "name": "tiro-scribe",
  "version": "0.1.0",
  "private": true,
  "description": "Privacy-first clinical research app with on-device AI processing",
  "main": "index.js",
  "scripts": {
    "preios": "rm -rf $TMPDIR/metro-* $TMPDIR/haste-* /tmp/metro-* /tmp/haste-* 2>/dev/null || true",
    "android": "STORYBOOK_ENABLED=false expo run:android",
    "ios": "STORYBOOK_ENABLED=false expo run:ios",
    "prebuild": "expo prebuild",
    "prebuild:clean": "expo prebuild --clean",
    "start": "expo start",
    "start:dev-client": "expo start --dev-client",
    "start:reset": "expo start --clear",
    "prestorybook": "rm -rf $TMPDIR/metro-* $TMPDIR/haste-* /tmp/metro-* /tmp/haste-* node_modules/.cache .expo 2>/dev/null || true",
    "storybook": "STORYBOOK_ENABLED=true expo start --clear",
    "storybook:ios": "STORYBOOK_ENABLED=true expo start --clear --ios",
    "storybook:android": "STORYBOOK_ENABLED=true expo start --clear --android",
    "clean": "expo prebuild --clean",
    "clean:metro": "rm -rf /tmp/metro-* /tmp/haste-* $TMPDIR/metro-* $TMPDIR/haste-* 2>/dev/null || true",
    "lint": "eslint .",
    "test": "jest --testPathIgnorePatterns=/tests/Recording/ --passWithNoTests",
    "test:typescript": "jest --testPathIgnorePatterns=/tests/Recording/ --passWithNoTests",
    "test:kotlin": "if [ -d 'android' ] && [ -f 'android/gradlew' ]; then cd android && ./gradlew :secure-recorder:test; else exit 1; fi",
    "test:swift": "if [ -d 'ios' ] && [ -f 'ios/TiroScribe.xcworkspace' ]; then cd ios && xcodebuild test -workspace TiroScribe.xcworkspace -scheme TiroScribe -destination 'platform=iOS Simulator,name=iPhone 15' -destination 'platform=iOS Simulator,name=iPad Pro (12.9-inch) (6th generation)'; else exit 1; fi",
    "test:all": "pnpm test:typescript; pnpm test:kotlin || true; pnpm test:swift || true",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@legendapp/state": "^2.1.15",
    "@nozbe/simdjson": "^3.9.4",
    "@nozbe/watermelondb": "^0.28.0",
    "@nozbe/with-observables": "^1.6.0",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-navigation/bottom-tabs": "^7.9.1",
    "@react-navigation/native": "^7.1.27",
    "@react-navigation/native-stack": "^7.9.1",
    "colord": "^2.9.3",
    "crypto-js": "^4.2.0",
    "dayjs": "^1.11.19",
    "expo": "~54.0.31",
    "expo-asset": "~12.0.12",
    "expo-audio": "~1.1.1",
    "expo-build-properties": "~1.0.10",
    "expo-dev-client": "~6.0.20",
    "expo-file-system": "~19.0.21",
    "expo-status-bar": "~3.0.9",
    "lucide-react-native": "^0.562.0",
    "onnxruntime-react-native": "^1.23.2",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-heroicons": "^4.0.0",
    "react-native-logs": "^5.5.0",
    "react-native-paper": "^5.14.5",
    "react-native-reanimated": "~4.1.6",
    "react-native-safe-area-context": "~5.6.2",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "^15.15.1",
    "react-native-worklets": "0.5.1",
    "uuid": "^13.0.0"
  },
  "devDependencies": {
    "@babel/core": "^7.28.6",
    "@babel/plugin-proposal-decorators": "^7.28.6",
    "@babel/preset-env": "^7.28.6",
    "@babel/runtime": "^7.28.6",
    "@eslint/eslintrc": "^3.3.3",
    "@eslint/js": "^9.39.2",
    "@gorhom/bottom-sheet": "^5.2.8",
    "@lovesworking/watermelondb-expo-plugin-sdk-52-plus": "^1.0.3",
    "@react-native-community/cli": "^20.1.0",
    "@react-native-community/datetimepicker": "^8.6.0",
    "@react-native-community/slider": "^5.1.2",
    "@react-native/babel-preset": "^0.83.1",
    "@react-native/eslint-config": "^0.83.1",
    "@react-native/metro-config": "^0.83.1",
    "@react-native/typescript-config": "^0.83.1",
    "@storybook/addon-ondevice-actions": "^10.1.11",
    "@storybook/addon-ondevice-controls": "^10.1.11",
    "@storybook/addon-ondevice-notes": "^10.1.11",
    "@storybook/react-native": "^10.1.11",
    "@testing-library/jest-native": "^5.4.3",
    "@testing-library/react-native": "^13.3.3",
    "@types/crypto-js": "^4.2.2",
    "@types/jest": "^30.0.0",
    "@types/react": "^19.1.17",
    "@types/react-test-renderer": "^19.1.0",
    "@typescript-eslint/eslint-plugin": "^8.53.0",
    "@typescript-eslint/parser": "^8.53.0",
    "babel-jest": "^29.7.0",
    "babel-plugin-module-resolver": "^5.0.2",
    "babel-plugin-transform-inline-environment-variables": "^0.4.4",
    "bplist-creator": "^0.1.1",
    "esbuild": "^0.27.2",
    "eslint": "^9.39.2",
    "jest": "^29.7.0",
    "jest-expo": "^54.0.16",
    "prettier": "^3.8.0",
    "react-dom": "^19.2.3",
    "react-test-renderer": "19.1.0",
    "storybook": "^10.1.11",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=8.0.0"
  }
}
