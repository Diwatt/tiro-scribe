    private async validateResponse(response: Response): Promise<Response> {
        if (response.ok) {
            const cloned = response.clone();
            let data: unknown;
            try {
                data = await cloned.json();
            } catch {
                data = {};
            }
            if (isEmpty(data)) {
                throw new ApiClientException('Response empty', 'RESPONSE_EMPTY');
            }
