    outputFile = tempDir.appendingPathComponent("test_session_\(UUID().uuidString).dat")
    
    session = Session(
      sessionId: "test-session",
      outputFile: outputFile,
      keyManager: keyManager,
      audioRecorder: audioRecorder,
      audioConfig: audioConfig
    )
