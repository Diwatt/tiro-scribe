        return this.status;
    }

    public getUpdatedAt(): Dayjs {
        return this.updatedAt;
    }

    public getUuid(): string {
        return this.uuid;
    }

    public get isProcessable(): boolean {
        if (this.status === QueueItemStatus.Pending) {
