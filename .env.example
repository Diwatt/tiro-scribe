# Optional: copy to .env and set values as needed.
# .env and .env.local are gitignored.
#
# All app config (env + defaults) lives in src/Config/AppConfig.ts.
# These variables override the defaults when set.

# API host: origin and optional path (AppConfig.apiHost). Defaults to https://api.tiro.com when unset.
# Examples: https://api.example.com  or  https://api.example.com/api
EXPO_PUBLIC_API_BASE_URL=https://api.tiro.com

# SQLite database file name (AppConfig.databaseName). Useful for per-environment DBs.
# EXPO_PUBLIC_DATABASE_NAME=tiro-scribe.sqlite

# Set to 'true' to enable Storybook in dev (AppConfig.isStorybookEnabled).
# Build entrypoints (index.js, metro.config.js, babel.config.js) also read STORYBOOK_ENABLED.
# STORYBOOK_ENABLED=false

# Directory under document dir where inference artifacts (ONNX) are stored (AppConfig.artifactStorageDirName). Path = ${dir}/${artifactId}.onnx.
# EXPO_PUBLIC_ARTIFACT_STORAGE_SUBDIR=artifacts

# When true and running in AppConfig.isDev, the app will delete its local SQLite
# database on every cold start. Handy for onboarding work. (AppConfig.shouldClearDbOnLaunch)
# EXPO_PUBLIC_CLEAR_DB_ON_LAUNCH=true
